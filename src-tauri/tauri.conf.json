{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "maxbar",
  "version": "0.3.0",
  "identifier": "fr.maxime.maxbar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "bar",
        "title": "maxbar",
        "url": "index.html",
        "width": 1200,
        "height": 42,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,OptimizationHints,MediaRouter --disable-background-networking --disable-component-update --disable-sync --no-first-run --disable-extensions --renderer-process-limit=1 --in-process-gpu --js-flags=--lite-mode"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
